# Line endings matter here: the .sh scripts run inside WSL — a CRLF checkout
# breaks them ("bad interpreter"). Force LF for shell scripts and repo files;
# PowerShell scripts get CRLF (Windows-native).
* text=auto
*.sh          text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
Dockerfile    text eol=lf
.gitignore    text eol=lf
*.ps1         text eol=crlf
*.png         binary
*.jpg         binary
